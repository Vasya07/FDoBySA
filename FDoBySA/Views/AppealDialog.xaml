<Window x:Class="FDoBySA.Views.AppealDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Апелляция - оспаривание заморозки" Height="417" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Подача апелляции" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Причина заморозки" FontWeight="Bold" Margin="0,0,0,5"/>
        <Border Grid.Row="2" Background="{StaticResource SidebarBackground}" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <TextBlock x:Name="txtFrozenReason" TextWrapping="Wrap" Foreground="#856404"/>
        </Border>

        <TextBlock Grid.Row="3" Text="Ваше обоснование для разморозки" FontWeight="Bold" 
                   Margin="0,0,0,10"/>
        <TextBox x:Name="txtAppealReason" Grid.Row="4" Height="150" 
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Padding="10" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    Margin="0,20,0,0" HorizontalAlignment="Center"/>

        <TextBlock x:Name="txtStatus" Grid.Row="6" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
        <Button Content="Отправить апелляцию" Height="NaN"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="Send_Click" Margin="75,170,235,0" Grid.Row="4"/>
        <Button Content="Отмена" Height="NaN" Margin="235,170,125,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click" Grid.Row="4"/>
    </Grid>
</Window>