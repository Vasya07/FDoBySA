<Window x:Class="FDoBySA.Views.AppealDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Апелляция - оспаривание заморозки" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Подача апелляции" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Причина заморозки" FontWeight="Bold" Margin="0,0,0,5"/>
        <Border Grid.Row="2" Background="#FFF3CD" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <TextBlock x:Name="txtFrozenReason" TextWrapping="Wrap" Foreground="#856404"/>
        </Border>

        <TextBlock Grid.Row="3" Text="Ваше обоснование для разморозки" FontWeight="Bold" 
                   Margin="0,0,0,10"/>
        <TextBox x:Name="txtAppealReason" Grid.Row="4" Height="150" 
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Padding="10" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" 
                    Margin="0,20,0,0" HorizontalAlignment="Center">
            <Button Content="Отправить апелляцию" Width="150" Height="35"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="Send_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Margin="10,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="6" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>