<Window x:Class="FDoBySA.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="FrozenWarning" Grid.Row="0" Background="{StaticResource SidebarBackground}" Height="40"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Ваш аккаунт заморожен! Причина: " 
                           Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtFrozenReason" Foreground="White" 
                           VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text=". Перейдите в профиль для подачи апелляции на разморозку аккаунта!" 
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
                <StackPanel Margin="0,20">
                    <Button x:Name="btnCatalog" ToolTip="Каталог книг" Click="BtnCatalog_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/book.png" Width="32" Height="32"/>
                    </Button>

                    <Button x:Name="btnLists" ToolTip="Списки книг" Click="BtnLists_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/list.png" Width="32" Height="32"/>
                    </Button>

                    <Button x:Name="btnAdmin" ToolTip="Администрирование" Click="BtnAdmin_Click"
                            Visibility="Collapsed" Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/admin.png" Width="32" Height="32"/>
                    </Button>

                    <Button x:Name="btnAuthor" ToolTip="Страница автора" Click="BtnAuthor_Click"
                            Visibility="Collapsed" Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/author.png" Width="32" Height="32"/>
                    </Button>

                    <Separator Margin="10,20" Background="#34495E"/>

                    <Button x:Name="btnProfile" ToolTip="Профиль" Click="BtnProfile_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/profile.png" Width="32" Height="32"/>
                    </Button>

                    <Button x:Name="btnLogout" ToolTip="Выход" Click="BtnLogout_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Image Source="/Images/logout.png" Width="32" Height="32"/>
                    </Button>
                </StackPanel>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>