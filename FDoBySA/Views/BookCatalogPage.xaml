<Page x:Class="FDoBySA.Views.BookCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг"
      Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="5" 
                Padding="15" Margin="0,0,0,20" Effect="{StaticResource ShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBox x:Name="txtSearch" Width="300" Height="32" 
                             FontSize="14" Padding="10,0"
                             TextChanged="Search_TextChanged"/>
                    <Button Content="Поиск" Width="80" Height="32" Margin="10,0,0,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Search_Click"/>
                    <Button Content="Сброс" Width="80" Height="32" Margin="5,0,0,0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Reset_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbSort" Width="120" Height="32"
                              SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="По названию" IsSelected="True"/>
                        <ComboBoxItem Content="По оценке"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="20,0,0,0">
                    <TextBlock Text="Жанр:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbGenre" Width="150" Height="32"
                              SelectionChanged="Genre_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BooksGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BookCardStyle}">
                            <StackPanel>
                                <Border Background="#F0F0F0" CornerRadius="3" 
                                        Width="180" Height="240">
                                    <Image Source="{Binding CoverPath}" 
                                           Width="180" Height="240" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock Text="{Binding Title}" 
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,10,0,5" 
                                           TextWrapping="Wrap" MaxHeight="40"/>

                                <TextBlock Text="{Binding AuthorName}" 
                                           Foreground="#666" FontSize="12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                    <Image Source="/Images/star.png" Width="16" Height="16"/>
                                    <TextBlock Text="{Binding AvgRating, StringFormat=' {0:F1}'}"
                                               Foreground="Gold" FontWeight="Bold"/>
                                    <TextBlock Text=" / 10" Foreground="#999"/>
                                </StackPanel>

                                <WrapPanel Margin="0,5,0,10">
                                    <ItemsControl ItemsSource="{Binding Genres}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E0E0E0" 
                                                        CornerRadius="3" 
                                                        Padding="5,2" Margin="0,0,5,3">
                                                    <TextBlock Text="{Binding}" 
                                                               FontSize="10"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Center">
                                    <Button Content="Подробнее" Width="80" Height="30"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ReadBook_Click" Tag="{Binding}"/>
                                    <Button Content="В список" Width="80" Height="30"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AddToList_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="txtLoading" Grid.Row="1" 
                   Text="Загрузка книг..." 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="14" Foreground="#999"
                   Visibility="Collapsed"/>
    </Grid>
</Page>