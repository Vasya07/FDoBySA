<Page x:Class="FDoBySA.Views.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль пользователя"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SidebarBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Информация о пользователе" 
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Логин:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtLogin" VerticalAlignment="Center"/>

                        <TextBlock Text="Отображаемое имя:" FontWeight="Bold" 
                                   Grid.Row="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" x:Name="txtDisplayName" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Email:" FontWeight="Bold" 
                                   Grid.Row="2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" x:Name="txtEmail" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Роль:" FontWeight="Bold" 
                                   Grid.Row="3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="3" x:Name="txtRole" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Дата регистрации:" FontWeight="Bold" 
                                   Grid.Row="4" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="4" x:Name="txtCreatedAt" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Статус:" FontWeight="Bold" 
                                   Grid.Row="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="5" x:Name="txtStatus" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="FrozenWarning" Grid.Row="1" Background="{StaticResource SidebarBackground}" 
                    BorderBrush="#FFC107" BorderThickness="1" CornerRadius="5" Padding="15"
                    Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Ваш аккаунт заморожен!" 
                               FontWeight="Bold" Foreground="#856404"/>
                    <TextBlock x:Name="txtFrozenReason" Margin="0,10,0,10" 
                               TextWrapping="Wrap"/>
                    <Button Content="Подать апелляцию" Width="150" Height="35"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="Appeal_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="AuthorRequestPanel" Grid.Row="2" Background="{StaticResource SidebarBackground}" 
                    CornerRadius="5" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Станьте автором!" 
                               FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Публикуйте свои книги и делитесь творчеством"
                               Margin="0,5,0,10"/>
                    <Button x:Name="btnRequestAuthor" Content="Подать заявку на автора"
                            Width="200" Height="35"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="RequestAuthor_Click"/>
                    <TextBlock x:Name="txtRequestStatus" Foreground="#2196F3"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource SidebarBackground}" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Мои отзывы" FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ReviewsGrid">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                            Padding="10" Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock FontWeight="Bold">
                                                    <Run Text="Книга: "/>
                                                    <Run Text="{Binding BookTitle, Mode=OneWay}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                                    <Image Source="/Images/star.png" 
                                                           Width="14" Height="14"/>
                                                    <TextBlock Text="{Binding Rating, Mode=OneWay}" 
                                                               Margin="3,0,0,0"/>
                                                    <TextBlock Text="/10" Foreground="#999"/>
                                                    <TextBlock Text=" | " Foreground="#CCC"/>
                                                    <TextBlock Text="{Binding CreatedAt, 
                                                        StringFormat='dd.MM.yyyy', Mode=OneWay}" 
                                                               Foreground="#999"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReviewText, Mode=OneWay}"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" 
                                                    Content="Удалить отзыв" Width="100" Height="30"
                                                    ToolTip="Удалить отзыв"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Click="DeleteReview_Click"
                                                    Tag="{Binding ReviewId, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="txtNoReviews" Text="У вас пока нет отзывов"
                               Foreground="#999" HorizontalAlignment="Center"
                               Margin="0,20,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>