<Window x:Class="FDoBySA.Views.ComplaintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подать жалобу" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Подача жалобы" 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Причина жалобы" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBox x:Name="txtReason" Grid.Row="2" Height="150" 
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Padding="10" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    Margin="0,20,0,0" HorizontalAlignment="Center">
            <Button Content="Отправить" Width="120" Height="35"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="Send_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Margin="10,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="4" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>