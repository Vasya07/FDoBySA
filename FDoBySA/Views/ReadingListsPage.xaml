<Page x:Class="FDoBySA.Views.ReadingListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои списки книг"
      Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои списки книг" FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Height="40" Margin="0,0,0,20"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Читаю" Tag="Читаю"/>
            <TabItem Header="В планах" Tag="В планах"/>
            <TabItem Header="Прочитано" Tag="Прочитано"/>
            <TabItem Header="Заброшено" Tag="Заброшено"/>
        </TabControl>

        <Border Grid.Row="2" Background="White" CornerRadius="5" 
                Padding="15" Margin="0,0,0,15" Height="Auto" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Width="300" Height="32" 
                         FontSize="14" Padding="10,0"
                         TextChanged="Search_TextChanged"/>

                <Button Content="Сброс" Width="80" Height="32" Grid.Column="1" Margin="10,0,0,0"
                        Style="{StaticResource ActionButtonStyle}" Click="Reset_Click"/>

                <ComboBox x:Name="cmbSort" Width="120" Height="32" Grid.Column="2" Margin="10,0,0,0"
                          SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По оценке"/>
                </ComboBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,80,0,0">
            <ItemsControl x:Name="BooksGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BookCardStyle}">
                            <StackPanel>
                                <Border Background="#F0F0F0" CornerRadius="3" 
                                        Width="180" Height="240">
                                    <Image Source="{Binding CoverPath}" 
                                           Width="180" Height="240" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock Text="{Binding Title}" 
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,10,0,5" 
                                           TextWrapping="Wrap" MaxHeight="40"/>

                                <TextBlock Text="{Binding AuthorName}" 
                                           Foreground="#666" FontSize="12"/>

                                <TextBlock Text="{Binding AvgRating, StringFormat='⭐ {0:F1}/10'}"
                                           Foreground="Gold" Margin="0,5,0,5"/>

                                <ComboBox x:Name="cmbStatus" 
                                          Width="120" Height="28" Margin="0,5,0,5"
                                          SelectionChanged="Status_Changed"
                                          Tag="{Binding BookId}"
                                          Loaded="ComboBox_Loaded">
                                    <ComboBoxItem Content="Читаю"/>
                                    <ComboBoxItem Content="В планах"/>
                                    <ComboBoxItem Content="Прочитано"/>
                                    <ComboBoxItem Content="Заброшено"/>
                                </ComboBox>

                                <Button Content="Читать" Width="120" Height="30"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="ReadBook_Click" Tag="{Binding BookId}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="txtEmpty" Grid.Row="2" 
                   Text="В этом списке пока нет книг. Добавьте книги из каталога"
                   FontSize="14" Foreground="#999"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>