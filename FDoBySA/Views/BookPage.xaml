<Page x:Class="FDoBySA.Views.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чтение книги"
      Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBackground}" Padding="10" 
                BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Button Content="Назад к каталогу" Width="150" Height="30"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Back_Click"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource SidebarBackground}" CornerRadius="5" 
                            Width="200" Height="267" Margin="0,0,20,0">
                        <Image x:Name="BookCover" Width="200" Height="267" 
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="BookTitle" FontSize="28" FontWeight="Bold" 
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="BookAuthor" FontSize="16" Foreground="#666"
                                   Margin="0,10,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Image Source="/Images/star.png" Width="24" Height="24"/>
                            <TextBlock x:Name="BookRating" FontSize="20" FontWeight="Bold"
                                       Margin="5,0,0,0"/>
                            <TextBlock Text="/10" FontSize="16" Foreground="#999"/>
                        </StackPanel>

                        <WrapPanel x:Name="GenresPanel" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="btnAddToList" Content="В мои списки"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Width="150" Height="35" Click="AddToList_Click"/>

                            <Button x:Name="btnComplaint" Content="Пожаловаться"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Width="150" Height="35" Margin="10,0,0,0"
                                    Click="Complaint_Click"/>

                            <Button x:Name="btnFreeze" Content="Заморозить книгу"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Width="150" Height="35" Margin="10,0,0,0"
                                    Visibility="Collapsed" Click="FreezeBook_Click"/>
                        </StackPanel>
                        
                        <TextBlock Text="Описание" FontSize="18" FontWeight="Bold"
                                   Margin="0,20,0,10"/>
                        <TextBlock x:Name="BookDescription" TextWrapping="Wrap"
                                   FontSize="14" Foreground="#555"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SidebarBackground}" CornerRadius="5"
                        Margin="0,0,0,20" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Отрывок из книги" FontSize="20" FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="BookContent" FontSize="14" 
                                       LineHeight="22" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource SidebarBackground}" CornerRadius="5" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Отзывы читателей" FontSize="20" FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Border Background="{StaticResource SidebarBackground}" CornerRadius="5" Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Ваш отзыв:" FontWeight="Bold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Оценка:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbRating" Width="60" Margin="10,0,0,0">
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="7" IsSelected="True"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBox x:Name="txtReview" Height="80" 
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         Padding="10" Margin="0,0,0,10"/>
                                <Button Content="Отправить отзыв" Width="150" Height="35"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Click="AddReview_Click"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="ReviewsGrid">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SidebarBackground}" BorderThickness="0,0,0,1"
                                            Padding="10" Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding UserName}" 
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CreatedAt, 
                                                    StringFormat='dd.MM.yyyy'}" 
                                                           FontSize="10" Foreground="#999"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="/Images/star.png" 
                                                           Width="14" Height="14"/>
                                                    <TextBlock Text="{Binding Rating}"
                                                               Margin="3,0,0,0"/>
                                                    <TextBlock Text="/10" Foreground="#999"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReviewText}"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" 
                                                        Orientation="Horizontal">
                                                <Button Content="Жалоба" Width="75" Height="30"
                                                        ToolTip="Пожаловаться на отзыв"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Click="ComplaintOnReview_Click"
                                                        Tag="{Binding ReviewId}"/>

                                                <Button x:Name="btnFreezeReview" 
                                                        Content="Заморозить" Width="75" Height="30"
                                                        Margin="5,0,0,0"
                                                        ToolTip="Заморозить отзыв"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Visibility="Collapsed"
                                                        Click="FreezeReview_Click"
                                                        Tag="{Binding ReviewId}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>