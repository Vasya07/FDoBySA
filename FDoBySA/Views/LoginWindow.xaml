<Window x:Class="FDoBySA.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Читай, Пиши и не спиши" 
        Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,40">
            <TextBlock Text="Читай, Пиши и не спиши" 
                       FontSize="22" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,10,0,5"/>
            <TextBlock Text="Платформа для книг маленьких авторов" 
                       FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Логин" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtLogin" Grid.Row="2" Height="35" 
                 FontSize="14" Padding="10,0"/>

        <TextBlock Grid.Row="3" Text="Пароль" FontWeight="Bold" 
                   Margin="0,15,0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="4" Height="35"
                     FontSize="14" Padding="10,0"/>

        <Button x:Name="btnLogin" Grid.Row="5" Content="Войти" 
                Style="{StaticResource ActionButtonStyle}"
                Height="40" FontSize="14" Margin="0,20,0,10"
                Click="Login_Click"/>

        <Button x:Name="btnRegister" Grid.Row="6" 
                Content="Создать аккаунт"
                Style="{StaticResource SuccessButtonStyle}"
                Height="40" FontSize="14"
                Click="Register_Click"/>

        <TextBlock x:Name="txtStatus" Grid.Row="8" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>