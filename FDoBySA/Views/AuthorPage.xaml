<Page x:Class="FDoBySA.Views.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница автора"
      Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои книги" FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Добавить книгу" Width="150" Height="35"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="AddBook_Click"/>
            <Button x:Name="btnFrozenBooks" Content="Замороженные книги" Width="180" Height="35"
                    Margin="10,0,0,0"
                    Style="{StaticResource WarningButtonStyle}"
                    Click="ShowFrozenBooks_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BooksGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BookCardStyle}">
                            <StackPanel>
                                <Border Background="#F0F0F0" CornerRadius="3" 
                                        Width="180" Height="240">
                                    <Image Source="{Binding CoverPath}" 
                                           Width="180" Height="240" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock Text="{Binding Title}" 
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,10,0,5" 
                                           TextWrapping="Wrap" MaxHeight="40"/>

                                <TextBlock Text="{Binding Description}" 
                                           Foreground="#666" FontSize="11"
                                           TextWrapping="Wrap" MaxHeight="40"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}"
                                           FontSize="10" Foreground="#999"
                                           Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="✏️" Width="30" Height="30"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="EditBook_Click" Tag="{Binding BookId}"/>
                                    <Button Content="📖" Width="30" Height="30" Margin="5,0,0,0"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="ReadBook_Click" Tag="{Binding BookId}"/>
                                    <Button Content="⚠️" Width="30" Height="30" Margin="5,0,0,0"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteBook_Click" Tag="{Binding BookId}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>