<Window x:Class="FDoBySA.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="540" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Регистрация" 
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин*" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtLogin" Grid.Row="2" Height="35" Padding="10,0"/>

        <TextBlock Grid.Row="3" Text="Пароль*" FontWeight="Bold" Margin="0,15,0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="4" Height="35" Padding="10,0"/>

        <TextBlock Grid.Row="5" Text="Подтверждение пароля*" FontWeight="Bold" Margin="0,15,0,5"/>
        <PasswordBox x:Name="txtConfirmPassword" Grid.Row="6" Height="35" Padding="10,0"/>

        <TextBlock Grid.Row="7" Text="Email*" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtEmail" Grid.Row="8" Height="35" Padding="10,0"/>

        <TextBlock Grid.Row="9" Text="Отображаемое имя*" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtDisplayName" Grid.Row="10" Height="35" Padding="10,0"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" 
                    Margin="0,30,0,10" HorizontalAlignment="Center">
            <Button Content="Зарегистрироваться" 
                    Style="{StaticResource SuccessButtonStyle}"
                    Width="180" Height="40" Click="Register_Click"/>
            <Button Content="Отмена" 
                    Style="{StaticResource ActionButtonStyle}"
                    Width="100" Height="40" Margin="10,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="12" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,0" Visibility="Collapsed"/>

        <Border Grid.Row="13" Background="#FFF3CD" CornerRadius="5" 
                Padding="10" Margin="0,15,0,0" BorderBrush="#FFC107" BorderThickness="1">
            <TextBlock Text="Поля, отмеченные звёздочкой (*), являются обязательными для заполнения"
                       Foreground="#856404" FontSize="11" 
                       TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>