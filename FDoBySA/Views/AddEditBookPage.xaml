<Window x:Class="FDoBySA.Views.AddEditBookPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/Редактирование книги" 
        Height="820" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Добавление книги" FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,20" x:Name="TitleLabel"/>

        <TextBlock Grid.Row="1" Text="Название книги*" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="txtTitle" Grid.Row="2" Height="35" Padding="10,0"/>

        <TextBlock Grid.Row="3" Text="Жанры" FontWeight="Bold" Margin="0,15,0,5"/>
        <ListBox x:Name="lstGenres" Grid.Row="4" Height="120" 
                 SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding GenreName}" 
                              IsChecked="{Binding IsSelected}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="5" Text="Описание" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtDescription" Grid.Row="6" Height="100" 
                 TextWrapping="Wrap" AcceptsReturn="True" Padding="10"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="7" Text="Текст книги*" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtContent" Grid.Row="8" Height="200" 
                 TextWrapping="Wrap" AcceptsReturn="True" Padding="10"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" 
                    Margin="0,20,0,10" HorizontalAlignment="Center">
            <Button Content="Сохранить" Width="120" Height="35"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="Save_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Margin="10,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>
        </StackPanel>
        
        <Border Grid.Row="10" Background="#FFF3CD" CornerRadius="5" 
                Padding="10" Margin="0,10,0,0" BorderBrush="#FFC107" BorderThickness="1">
            <TextBlock Text="Поля, отмеченные звёздочкой (*), являются обязательными для заполнения"
                       Foreground="#856404" FontSize="11" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>