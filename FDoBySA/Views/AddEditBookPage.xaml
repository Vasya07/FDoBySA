<Window x:Class="FDoBySA.Views.AddEditBookPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/Редактирование книги" 
        Height="1000" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Добавление книги" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,20" x:Name="TitleLabel"/>

            <TextBlock Grid.Row="1" Text="Название книги*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTitle" Grid.Row="2" Height="35" Padding="10,0"/>

            <TextBlock Grid.Row="3" Text="Обложка (оптимальный размер: 300x400 px)" FontWeight="Bold" Margin="0,15,0,5"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBox x:Name="txtCoverPath" Width="400" Height="30" 
                         IsReadOnly="True" Background="#F5F5F5" Padding="5"/>
                <Button Content="Выбрать файл" Width="100" Height="30" Margin="10,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SelectCover_Click"/>
            </StackPanel>

            <Border Grid.Row="5" Background="{StaticResource SidebarBackground}" CornerRadius="5" 
                    Width="150" Height="200" Margin="0,5,0,10">
                <Image x:Name="imgPreview" Stretch="UniformToFill"
                       ToolTip="Предпросмотр обложки"/>
            </Border>

            <TextBlock Grid.Row="6" Text="Жанры" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListBox x:Name="lstGenres" Grid.Row="7" Height="100" 
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding GenreName}" 
                                  IsChecked="{Binding IsSelected}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="8" Text="Описание" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBox x:Name="txtDescription" Grid.Row="9" Height="80" 
                     TextWrapping="Wrap" AcceptsReturn="True" Padding="10"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="10" Text="Текст книги*" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBox x:Name="txtContent" Grid.Row="11" Height="150" 
                     TextWrapping="Wrap" AcceptsReturn="True" Padding="10"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="12" Orientation="Horizontal" 
                        Margin="0,20,0,10" HorizontalAlignment="Center">
                <Button Content="Сохранить" Width="120" Height="35"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="Save_Click"/>
                <Button Content="Отмена" Width="100" Height="35" Margin="10,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>